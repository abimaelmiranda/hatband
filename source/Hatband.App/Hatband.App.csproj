<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Resources.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Hatband.App.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Resources</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hatband.Core\Hatband.Core.csproj" />
    <ProjectReference Include="..\Hatband.Infrastructure\Hatband.Infrastructure.csproj" />
    <ProjectReference Include="..\Hatband.SDK.UI\Hatband.SDK.UI.csproj" />
    <HatbandPluginProject Include="..\Hatband.Plugins.Steam\Hatband.Plugins.Steam.csproj" />
    <HatbandPluginProject Include="..\Hatband.Plugins.IGN\Hatband.Plugins.IGN.csproj" />
    <HatbandPluginProject Include="..\Hatband.Plugins.HowLongToBeat\Hatband.Plugins.HowLongToBeat.csproj" />
    <HatbandPluginProject Include="..\Hatband.Plugins.Proton\Hatband.Plugins.Proton.csproj" />
    <HatbandPluginProject Include="..\Hatband.Plugins.UMU\Hatband.Plugins.UMU.csproj" />
    <ProjectReference Include="@(HatbandPluginProject)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <Target Name="CopyHatbandPlugins" AfterTargets="Build">
    <MSBuild Projects="@(HatbandPluginProject)" Targets="GetHatbandPluginPackageFiles" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="HatbandPluginOutput" />
    </MSBuild>
    <Delete Files="$(OutDir)hatband-plugin.json" />
    <RemoveDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="@(HatbandPluginOutput->'%(PluginSourcePath)')"
          DestinationFiles="@(HatbandPluginOutput->'$(OutDir)plugins/%(PluginId)/%(PluginRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyHatbandPluginsToPublish" AfterTargets="Publish">
    <MSBuild Projects="@(HatbandPluginProject)" Targets="GetHatbandPluginPackageFiles" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="HatbandPluginPublishOutput" />
    </MSBuild>
    <Delete Files="$(PublishDir)hatband-plugin.json" />
    <RemoveDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(HatbandPluginPublishOutput->'%(PluginSourcePath)')"
          DestinationFiles="@(HatbandPluginPublishOutput->'$(PublishDir)plugins/%(PluginId)/%(PluginRelativePath)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

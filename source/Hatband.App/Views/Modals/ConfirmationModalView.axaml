<navigation:ModalView xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:navigation="using:Hatband.App.Views.Navigation"
                     xmlns:vm="using:Hatband.App.ViewModels"
                     xmlns:lang="using:Hatband.App.Localization"
                     x:Class="Hatband.App.Views.Modals.ConfirmationModalView"
                     x:DataType="vm:ConfirmationModalViewModel">
    <Border Width="460" Padding="24" CornerRadius="12" Background="#F21C252F"
            BorderBrush="#526B7884" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Typography.ScreenTitle}" FontWeight="Bold" />
            <TextBlock Text="{Binding Subject}" FontSize="{DynamicResource Typography.Subheading}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Foreground="#CFD7DE" FontSize="{DynamicResource Typography.Body}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Content="{x:Static lang:Resources.Cancel}"
                        Classes="subtle-action confirmation-action" Click="OnCancelClick" />
                <Button Content="{Binding ConfirmLabel}" Classes="danger-action confirmation-action" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</navigation:ModalView>

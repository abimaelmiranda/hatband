<navigation:ModalView xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:navigation="using:Hatband.App.Views.Navigation"
                     xmlns:vm="using:Hatband.App.ViewModels"
                     xmlns:components="using:Hatband.App.Views.Components"
                     xmlns:lang="using:Hatband.App.Localization"
                     x:Class="Hatband.App.Views.Modals.GameOptionsModalView"
                     x:DataType="vm:GameOptionsViewModel">
    <Border Classes="simple-modal-frame" Background="#F21C252F">
        <Grid RowDefinitions="Auto,*" RowSpacing="15">
            <StackPanel Spacing="3">
                <TextBlock Text="{x:Static lang:Resources.GameOptions}" Foreground="#AFC0CC" FontSize="{DynamicResource Typography.Caption}" />
                <TextBlock Text="{Binding Game.Name}" FontSize="{DynamicResource Typography.ScreenTitle}" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl x:Name="OptionsHost" Grid.Row="1" ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameOptionViewModel">
                        <components:ConsoleNavigationItemView Title="{Binding Title}"
                                                              IconGlyph="{Binding IconGlyph}"
                                                              FocusEntered="OnOptionFocusEntered"
                                                              Activated="OnOptionActivated" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</navigation:ModalView>

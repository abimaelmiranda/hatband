<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels.Settings"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="Hatband.App.Views.Screens.SteamConnectorSettingsView"
             x:DataType="vm:SettingsScreenViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="{x:Static lang:Resources.SteamAccount}"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <StackPanel IsVisible="{Binding !IsConnectorConnected}" Spacing="10">
            <TextBlock Text="{x:Static lang:Resources.ConnectorDescription}"
                       Foreground="#AEBBC5"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <Button x:Name="SteamConnectButton"
                    HorizontalAlignment="Left"
                    Command="{Binding ConnectSteamCommand}"
                    IsEnabled="{Binding CanStartSteamLogin}"
                    Background="#2E3842"
                    Foreground="#F1F5F8"
                    Padding="13,9"
                    CornerRadius="6"
                    Classes="connector-focus">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Static lang:Resources.LoginWithQr}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <icons:FluentIcon Icon="ArrowUpRight"
                                      Foreground="#AEBBC5"
                                      Width="14"
                                      Height="14" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding SteamConnectionStatus}"
                       Foreground="#AEBBC5"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <Image Source="{Binding SteamQrCode}"
                   IsVisible="{Binding IsSteamLoginPending}"
                   Width="180"
                   Height="180"
                   HorizontalAlignment="Left" />
            <Button Content="{x:Static lang:Resources.CancelConnection}"
                    x:Name="SteamCancelButton"
                    IsVisible="{Binding IsSteamLoginPending}"
                    HorizontalAlignment="Left"
                    Command="{Binding CancelSteamLoginCommand}"
                    Classes="subtle-action connector-focus"
                    Padding="12,8"
                    FontSize="12" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsConnectorConnected}" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="7"
                        Height="7"
                        CornerRadius="4"
                        Background="#82D9A0"
                        VerticalAlignment="Center" />
                <TextBlock Text="{x:Static lang:Resources.Connected}"
                           FontSize="11"
                           Foreground="#82D9A0"
                           FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding ActiveConnectorAccountName}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding SteamConnectionStatus}"
                       Foreground="#B9C4CC"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Button Content="{x:Static lang:Resources.SyncLibrary}"
                        x:Name="SteamSyncButton"
                        Command="{Binding SyncConnectedSteamLibraryCommand}"
                        Classes="subtle-action connector-focus"
                        Padding="13,9"
                        FontSize="12" />
                <Button Content="{x:Static lang:Resources.DisconnectAccount}"
                        x:Name="SteamDisconnectButton"
                        Command="{Binding DisconnectSteamCommand}"
                        Classes="subtle-action connector-focus"
                        Padding="13,9"
                        FontSize="12" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

<navigation:FullScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:navigation="using:Hatband.App.Views.Navigation"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:components="using:Hatband.App.Views.Components"
             x:Class="Hatband.App.Views.Screens.CompatibilitySettingsScreenView"
             x:DataType="vm:CompatibilitySettingsScreenViewModel">
    <Grid Background="Transparent">
        <components:FullScreenNavigationLayout IsMainContentActive="True">
            <components:FullScreenNavigationLayout.NavigationContent>
                <Border Background="#151C21" CornerRadius="8" Padding="14" Margin="2,1" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static lang:Resources.Compatibility}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GameName}" Foreground="#AFC0CC" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </components:FullScreenNavigationLayout.NavigationContent>
            <components:FullScreenNavigationLayout.MainContent>
                <Grid RowDefinitions="Auto,*" Margin="0,0,16,0">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                        <TextBlock Text="{Binding GameName}" FontSize="{DynamicResource Typography.ScreenTitle}" FontWeight="SemiBold" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsSaving}">
                        <components:CompatibilityEditorView x:Name="EditorView" DataContext="{Binding Editor}" />
                    </ScrollViewer>
                </Grid>
            </components:FullScreenNavigationLayout.MainContent>
            <components:FullScreenNavigationLayout.FooterContent>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,16,0" IsEnabled="{Binding !IsSaving}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F5D59A" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{x:Static lang:Resources.Cancel}" Classes="subtle-action standard-action" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsSaving}" />
                        <Button Content="{x:Static lang:Resources.Save}" Classes="console-action standard-action" Command="{Binding SaveCommand}" IsDefault="True" IsEnabled="{Binding !IsSaving}" />
                    </StackPanel>
                </Grid>
            </components:FullScreenNavigationLayout.FooterContent>
        </components:FullScreenNavigationLayout>
    </Grid>
</navigation:FullScreenView>

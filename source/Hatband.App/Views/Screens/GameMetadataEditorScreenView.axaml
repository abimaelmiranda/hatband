<navigation:FullScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:navigation="using:Hatband.App.Views.Navigation"
             xmlns:core="using:Hatband.Core.Models"
             xmlns:components="using:Hatband.App.Views.Components"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="Hatband.App.Views.Screens.GameMetadataEditorScreenView"
             x:DataType="vm:GameMetadataEditorViewModel">
    <Grid Background="Transparent">
    <components:FullScreenNavigationLayout x:Name="NavigationLayout">
        <components:FullScreenNavigationLayout.NavigationContent>
                    <StackPanel x:Name="EditorSectionList" Spacing="4">
                        <components:ConsoleNavigationItemView x:Name="MetadataSectionItem"
                                                              IconGlyph="Document"
                                                              Title="{x:Static lang:Resources.MetadataTab}"
                                                              FocusEntered="OnMetadataSectionFocusEntered"
                                                              Activated="OnMetadataSectionActivated" />
                        <components:ConsoleNavigationItemView x:Name="ArtworkSectionItem"
                                                              IconGlyph="Image"
                                                              Title="{x:Static lang:Resources.ArtworkTab}"
                                                              FocusEntered="OnArtworkSectionFocusEntered"
                                                              Activated="OnArtworkSectionActivated" />
                        <components:ConsoleNavigationItemView x:Name="SourcesSectionItem"
                                                              IconGlyph="ArrowSwap"
                                                              Title="{x:Static lang:Resources.MetadataSourcesTab}"
                                                              FocusEntered="OnSourcesSectionFocusEntered"
                                                              Activated="OnSourcesSectionActivated" />
                    </StackPanel>
        </components:FullScreenNavigationLayout.NavigationContent>

        <components:FullScreenNavigationLayout.MainContent>
                        <Grid>
                    <ScrollViewer x:Name="MetadataSectionContent"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10" Margin="0,8,8,0">
                        <TextBlock Text="{x:Static lang:Resources.Name}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                        <TextBox x:Name="NameBox" Text="{Binding Name}" />

                        <TextBlock Text="{x:Static lang:Resources.Description}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Description}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 MaxHeight="140"
                                 VerticalContentAlignment="Top" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static lang:Resources.Developer}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding Developer}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static lang:Resources.Publisher}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding Publisher}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static lang:Resources.Genre}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding Genre}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static lang:Resources.ReleaseDate}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Text="{Binding ReleaseDate}"
                                         PlaceholderText="{x:Static lang:Resources.ReleaseDateFormat}" />
                            </StackPanel>
                        </Grid>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FF9A9A"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasError}" />
                            </StackPanel>
                        </ScrollViewer>

                    <ScrollViewer x:Name="ArtworkSectionContent"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="False">
                            <StackPanel Spacing="12" Margin="0,8,8,0">
                        <TextBlock Text="{x:Static lang:Resources.GameArtwork}" FontSize="{DynamicResource Typography.Subheading}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Static lang:Resources.Cover}" Foreground="#D9E0E5" />
                                <TextBlock Text="{Binding CoverArtworkSelection}" Foreground="#AFC0CC" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="SearchCoverArtworkButton"
                                    Grid.Column="1"
                                    Content="{x:Static lang:Resources.SearchArtwork}"
                                    Classes="subtle-action"
                                    Tag="Cover"
                                    Click="OnSearchArtworkClick" />
                            <Button Grid.Column="2" Content="{x:Static lang:Resources.RestoreSource}" Classes="subtle-action" Tag="Cover" Click="OnRestoreArtworkClick" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Static lang:Resources.Background}" Foreground="#D9E0E5" />
                                <TextBlock Text="{Binding BackgroundArtworkSelection}" Foreground="#AFC0CC" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:Name="SearchBackgroundArtworkButton"
                                    Grid.Column="1"
                                    Content="{x:Static lang:Resources.SearchArtwork}"
                                    Classes="subtle-action"
                                    Tag="Background"
                                    Click="OnSearchArtworkClick" />
                            <Button Grid.Column="2" Content="{x:Static lang:Resources.RestoreSource}" Classes="subtle-action" Tag="Background" Click="OnRestoreArtworkClick" />
                        </Grid>

                            </StackPanel>
                        </ScrollViewer>

                    <ScrollViewer x:Name="SourcesSectionContent"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="False">
                            <StackPanel Spacing="10" Margin="0,8,8,0">
                        <TextBlock Text="{x:Static lang:Resources.MetadataSourcesTab}"
                                   FontSize="{DynamicResource Typography.Subheading}"
                                   FontWeight="SemiBold" />
                        <TabControl x:Name="MetadataSourceTabs"
                                    ItemsSource="{Binding MetadataSources}"
                                    SelectedItem="{Binding SelectedMetadataSource, Mode=TwoWay}"
                                    SelectionChanged="OnMetadataSourceSelectionChanged"
                                    IsVisible="{Binding HasMetadataSources}"
                                    HorizontalAlignment="Stretch">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GameMetadataSourceViewModel">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:GameMetadataSourceViewModel">
                                    <StackPanel Spacing="10" Margin="4,18,4,4">
                                        <StackPanel Spacing="10"
                                                    IsVisible="{Binding IsCustomSearchOpen}">
                                            <TextBlock Text="{x:Static lang:Resources.MetadataSourceSearchPrompt}"
                                                       Foreground="#AFC0CC"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBox Text="{Binding SearchQuery}"
                                                         PlaceholderText="{x:Static lang:Resources.Name}" />
                                                <Button Grid.Column="1"
                                                        Content="{x:Static lang:Resources.MetadataSourceSearch}"
                                                        Classes="subtle-action"
                                                        Command="{Binding SearchCommand}"
                                                        IsEnabled="{Binding CanSearch}" />
                                            </Grid>
                                            <Button Content="{x:Static lang:Resources.Back}"
                                                    Classes="subtle-action"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding CloseCustomSearchCommand}" />
                                        </StackPanel>
                                        <StackPanel Spacing="10"
                                                    IsVisible="{Binding IsResultViewVisible}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding SelectedResultName}"
                                                               FontSize="{DynamicResource Typography.ScreenTitle}"
                                                               FontWeight="SemiBold"
                                                               IsVisible="{Binding HasSearchResult}" />
                                                    <TextBlock Text="{x:Static lang:Resources.MetadataSourceSearching}"
                                                               Foreground="#AFC0CC"
                                                               IsVisible="{Binding IsSearching}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="{x:Static lang:Resources.MetadataSourceCustomSearch}"
                                                        Classes="subtle-action"
                                                        Command="{Binding OpenCustomSearchCommand}" />
                                            </Grid>
                                            <TextBlock Text="{Binding StatusMessage}"
                                                       Foreground="#AFC0CC"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasStatusMessage}" />
                                            <Border Background="#302B22"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    IsVisible="{Binding IsLanguageMismatch}">
                                                <TextBlock Text="{x:Static lang:Resources.MetadataLanguageMismatch}"
                                                           Foreground="#F5D59A"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel Spacing="6"
                                                        IsVisible="{Binding HasLookup}">
                                                <TextBlock Text="{Binding SelectedSearchResult.Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SelectedSearchResult.Developer}" />
                                                <TextBlock Text="{Binding SelectedSearchResult.Publisher}" />
                                                <TextBlock Text="{Binding SelectedSearchResult.Genre}" />
                                                <TextBlock Text="{Binding SelectedSearchResult.ReleaseDate}" />
                                            </StackPanel>
                                            <Button Content="{x:Static lang:Resources.MetadataSourceApply}"
                                                    Classes="subtle-action"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding ApplyCommand}"
                                                    IsVisible="{Binding HasLookup}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <TextBlock Text="{x:Static lang:Resources.NoMetadataSourcesAvailable}"
                                   Foreground="#AFC0CC"
                                   IsVisible="{Binding HasNoMetadataSources}" />

                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
        </components:FullScreenNavigationLayout.MainContent>

        <components:FullScreenNavigationLayout.FooterContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Content="{x:Static lang:Resources.Cancel}"
                            Classes="subtle-action standard-action"
                            Click="OnCancelClick" />
                    <Button Content="{x:Static lang:Resources.Save}"
                            Classes="console-action standard-action"
                            Command="{Binding SaveCommand}"
                            IsDefault="True" />
        </StackPanel>
        </components:FullScreenNavigationLayout.FooterContent>
    </components:FullScreenNavigationLayout>

    </Grid>
</navigation:FullScreenView>

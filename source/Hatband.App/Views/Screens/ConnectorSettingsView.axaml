<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="Hatband.App.Views.Screens.ConnectorSettingsView"
             x:DataType="vm:ConnectorLoginViewModel">
    <StackPanel Spacing="12" Margin="0,0,0,18">
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="{DynamicResource Typography.Subheading}"
                               FontWeight="SemiBold" />

                    <StackPanel IsVisible="{Binding !IsConnected}" Spacing="10">
                        <TextBlock Text="{x:Static lang:Resources.ConnectorDescription}"
                                   Foreground="#AEBBC5"
                                   FontSize="{DynamicResource Typography.Caption}"
                                   TextWrapping="Wrap" />
                        <Button Name="ConnectorConnectButton"
                                HorizontalAlignment="Left"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanStartLogin}"
                                Background="#2E3842"
                                Foreground="#F1F5F8"
                                Padding="13,9"
                                CornerRadius="6"
                                Classes="connector-focus">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Static lang:Resources.LoginWithQr}"
                                           FontSize="{DynamicResource Typography.BodySmall}"
                                           FontWeight="SemiBold" />
                                <icons:FluentIcon Icon="ArrowUpRight"
                                                  Foreground="#AEBBC5"
                                                  Width="14"
                                                  Height="14" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="#AEBBC5"
                                   FontSize="{DynamicResource Typography.Caption}"
                                   TextWrapping="Wrap" />
                        <Image Source="{Binding QrCode}"
                               IsVisible="{Binding IsLoginPending}"
                               Width="180"
                               Height="180"
                               HorizontalAlignment="Left" />
                        <Button Content="{x:Static lang:Resources.CancelConnection}"
                                Name="ConnectorCancelButton"
                                IsVisible="{Binding IsLoginPending}"
                                HorizontalAlignment="Left"
                                Command="{Binding CancelPendingLoginCommand}"
                                Classes="subtle-action connector-focus"
                                Padding="12,8"
                                FontSize="{DynamicResource Typography.Caption}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsConnected}" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Width="7"
                                    Height="7"
                                    CornerRadius="4"
                                    Background="#82D9A0"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static lang:Resources.Connected}"
                                       FontSize="{DynamicResource Typography.Caption}"
                                       Foreground="#82D9A0"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveAccountName}"
                                   FontSize="{DynamicResource Typography.Subheading}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Foreground="#B9C4CC"
                                   FontSize="{DynamicResource Typography.Caption}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Button Content="{x:Static lang:Resources.SyncLibrary}"
                                    Name="ConnectorSyncButton"
                                    Command="{Binding SyncLibraryCommand}"
                                    IsEnabled="{Binding CanSynchronizeLibrary}"
                                    Classes="subtle-action connector-focus"
                                    Padding="13,9"
                                    FontSize="{DynamicResource Typography.Caption}" />
                            <Button Content="{x:Static lang:Resources.DisconnectAccount}"
                                    Name="ConnectorDisconnectButton"
                                    Command="{Binding DisconnectAccountCommand}"
                                    Classes="subtle-action connector-focus"
                                    Padding="13,9"
                                    FontSize="{DynamicResource Typography.Caption}" />
                        </StackPanel>
                    </StackPanel>
    </StackPanel>
</UserControl>

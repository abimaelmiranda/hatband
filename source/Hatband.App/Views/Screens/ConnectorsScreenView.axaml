<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:components="using:Hatband.App.Views.Components"
             x:Class="Hatband.App.Views.Screens.ConnectorsScreenView"
             x:DataType="vm:MainWindowViewModel">
    <components:FullScreenNavigationLayout>
        <components:FullScreenNavigationLayout.NavigationContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConnectorList"
                                      ItemsSource="{Binding Connectors}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectorViewModel">
                                    <Button Background="Transparent"
                                            Height="44"
                                            HorizontalAlignment="Stretch"
                                            Padding="0"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnConnectorClick">
                                        <Border Padding="6,4"
                                                CornerRadius="6"
                                                Background="{Binding SelectionBackground}"
                                                BorderBrush="{Binding SelectionBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="32,*" ColumnSpacing="9">
                                                <Border Width="30" Height="30" CornerRadius="6"
                                                        Background="{Binding LogoBrush}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding LogoText}"
                                                                   IsVisible="{Binding !IsSteam}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="16"
                                                                   FontWeight="Bold" />
                                                        <Image Source="avares://Hatband.App/Assets/Stores/steamicon.png"
                                                               IsVisible="{Binding IsSteam}"
                                                               Width="25" Height="25"
                                                               Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
            </ScrollViewer>
        </components:FullScreenNavigationLayout.NavigationContent>

        <components:FullScreenNavigationLayout.MainContent>
                        <Grid>
                            <StackPanel IsVisible="{Binding !IsConnectorLoginScreen}"
                                        VerticalAlignment="Center"
                                        Spacing="7">
                                <TextBlock Text="{x:Static lang:Resources.SelectConnectorPrompt}"
                                           FontSize="19"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static lang:Resources.ConnectorDescription}"
                                           Foreground="#AEBBC5"
                                           FontSize="13" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsConnectorLoginScreen}"
                                        Spacing="12">
                                <TextBlock Text="{Binding SelectedConnector.DisplayName}"
                                           FontSize="19"
                                           FontWeight="SemiBold" />

                                <StackPanel IsVisible="{Binding !IsConnectorConnected}" Spacing="10">
                                    <TextBlock Text="{x:Static lang:Resources.ChooseConnectionMethod}"
                                               Foreground="#B9C4CC"
                                               FontSize="13" />
                                    <Button x:Name="SteamConnectButton"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ConnectSteamCommand}"
                                            IsEnabled="{Binding CanStartSteamLogin}"
                                            Background="#2E3842"
                                            Foreground="#F1F5F8"
                                            Padding="13,9"
                                            CornerRadius="6"
                                            Classes="connector-focus">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Static lang:Resources.LoginWithQr}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="↗"
                                                       Foreground="#AEBBC5"
                                                       FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding SteamConnectionStatus}"
                                               Foreground="#AEBBC5"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <Image Source="{Binding SteamQrCode}"
                                           IsVisible="{Binding IsSteamLoginPending}"
                                           Width="180" Height="180"
                                           HorizontalAlignment="Left" />
                                    <Button Content="{x:Static lang:Resources.CancelConnection}"
                                            x:Name="SteamCancelButton"
                                            IsVisible="{Binding IsSteamLoginPending}"
                                            HorizontalAlignment="Left"
                                            Command="{Binding CancelSteamLoginCommand}"
                                            Classes="subtle-action connector-focus"
                                            Padding="12,8"
                                            FontSize="12" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding IsConnectorConnected}" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="7" Height="7" CornerRadius="4"
                                                Background="#82D9A0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static lang:Resources.Connected}"
                                                   FontSize="11"
                                                   Foreground="#82D9A0"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveConnectorAccountName}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SteamConnectionStatus}"
                                               Foreground="#B9C4CC"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Button Content="{x:Static lang:Resources.SyncLibrary}"
                                                x:Name="SteamSyncButton"
                                                Command="{Binding SyncConnectedSteamLibraryCommand}"
                                                Classes="subtle-action connector-focus"
                                                Padding="13,9"
                                                FontSize="12" />
                                        <Button Content="{x:Static lang:Resources.DisconnectAccount}"
                                                x:Name="SteamDisconnectButton"
                                                Command="{Binding DisconnectSteamCommand}"
                                                Classes="subtle-action connector-focus"
                                                Padding="13,9"
                                                FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
        </components:FullScreenNavigationLayout.MainContent>
    </components:FullScreenNavigationLayout>
</UserControl>

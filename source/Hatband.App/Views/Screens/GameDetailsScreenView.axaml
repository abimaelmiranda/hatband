<navigation:FullScreenView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:navigation="using:Hatband.App.Views.Navigation"
             xmlns:lang="using:Hatband.App.Localization"
             xmlns:components="using:Hatband.App.Views.Components"
             x:Class="Hatband.App.Views.Screens.GameDetailsScreenView"
             x:DataType="vm:GameDetailsScreenViewModel">
    <Grid>
        <Image Classes="background-art"
               Source="{Binding Session.BackgroundImage}"
               Opacity="{Binding Session.BackgroundImageOpacity}"
               Stretch="UniformToFill" />
        <Image Classes="background-art"
               Source="{Binding Session.PreviousBackgroundImage}"
               Opacity="{Binding Session.PreviousBackgroundImageOpacity}"
               Stretch="UniformToFill" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#6610141A" Offset="0" />
                    <GradientStop Color="#3310141A" Offset="0.42" />
                    <GradientStop Color="#D9090D12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="40,28,40,68" RowDefinitions="*,Auto">
            <Grid Grid.Row="0"
                  ColumnDefinitions="1.05*,1.35*"
                  ColumnSpacing="16"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,14">
                <Border Padding="16"
                        CornerRadius="8"
                        Background="#C0090D12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="104,*" ColumnSpacing="14">
                            <components:GameArtworkView Width="118"
                                                        Height="168"
                                                        ShowTitle="False"
                                                        DataContext="{Binding Session.SelectedGameCard}"
                                                        VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Session.SelectedGameCard.Name}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="{Binding Session.SelectedGameCard.ReleaseYear}"
                                               Foreground="#D2D9DF"
                                               FontSize="12" />
                                    <TextBlock Text="·"
                                               Foreground="#D2D9DF"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding Session.SelectedGameCard.Genre}"
                                               Foreground="#D2D9DF"
                                               FontSize="12" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Button x:Name="PlayButton"
                                            Content="{Binding Session.PrimaryGameActionLabel}"
                                            Classes="console-action details-action"
                                            IsEnabled="{Binding Session.IsPrimaryGameActionEnabled}"
                                            IsVisible="{Binding !Session.IsSelectedGameManagementPending}"
                                            Command="{Binding ActivatePrimaryActionCommand}" />
                                    <ProgressBar Grid.ColumnSpan="2"
                                                 Width="152"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 IsIndeterminate="True"
                                                 IsVisible="{Binding Session.IsSelectedGameManagementPending}"
                                                 Background="#394650"
                                                 Foreground="#91C7F2" />
                                    <Button x:Name="OptionsButton"
                                            Grid.Column="1"
                                            Content="…"
                                            Classes="subtle-action details-options-action"
                                            ToolTip.Tip="{x:Static lang:Resources.GameOptionsTooltip}"
                                            IsVisible="{Binding !Session.IsSelectedGameManagementPending}"
                                            Command="{Binding OpenOptionsCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Text="{x:Static lang:Resources.Description}"
                                       Foreground="#CFD7DE"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Session.SelectedGameCard.Description}"
                                           Foreground="#E2E6EA"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="18,16"
                        CornerRadius="8"
                        Background="#A8090D12"
                        VerticalAlignment="Bottom">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                        <StackPanel Spacing="9">
                            <TextBlock Text="{x:Static lang:Resources.LibraryActivity}"
                                       Foreground="#CFD7DE"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                                <components:GameDetailStatView Label="{x:Static lang:Resources.PlaytimeLabel}"
                                                               Value="{Binding Session.SelectedGameCard.PlaytimeSummary}" />
                                <components:GameDetailStatView Grid.Column="1"
                                                               Label="{x:Static lang:Resources.LastActivityLabel}"
                                                               Value="{Binding Session.SelectedGameCard.LastActivitySummary}" />
                                <components:GameDetailStatView Grid.Row="1"
                                                               Label="{x:Static lang:Resources.Installation}"
                                                               Value="{Binding Session.SelectedGameCard.InstallStateLabel}" />
                                <components:GameDetailStatView Grid.Row="1" Grid.Column="1"
                                                               Label="{x:Static lang:Resources.FavoriteLabel}"
                                                               Value="{Binding Session.SelectedGameCard.FavoriteLabel}" />
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Background="#40586470"
                                HorizontalAlignment="Left"
                                Margin="-11,4,0,4" />

                        <StackPanel Grid.Column="1" Spacing="9">
                            <TextBlock Text="{x:Static lang:Resources.GameInformation}"
                                       Foreground="#CFD7DE"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="14">
                                <components:GameDetailStatView Label="{x:Static lang:Resources.Genre}"
                                                               Value="{Binding Session.SelectedGameCard.Genre}" />
                                <components:GameDetailStatView Grid.Column="1"
                                                               Label="{x:Static lang:Resources.Developer}"
                                                               Value="{Binding Session.SelectedGameCard.Developer}" />
                                <components:GameDetailStatView Grid.Row="1"
                                                               Label="{x:Static lang:Resources.Publisher}"
                                                               Value="{Binding Session.SelectedGameCard.Publisher}" />
                                <components:GameDetailStatView Grid.Row="1" Grid.Column="1"
                                                               Label="{x:Static lang:Resources.ReleaseDate}"
                                                               Value="{Binding Session.SelectedGameCard.ReleaseDateDisplay}" />
                                <StackPanel Grid.Row="2" Spacing="3">
                                    <TextBlock Text="{x:Static lang:Resources.NativePlatforms}"
                                               Foreground="#AFC0CC"
                                               FontSize="10" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Image Source="avares://Hatband.App/Assets/Icons/Platforms/windows.png"
                                               Width="17"
                                               Height="17"
                                               Stretch="Uniform"
                                               ToolTip.Tip="Windows"
                                               IsVisible="{Binding Session.SelectedGameCard.SupportsWindows}" />
                                        <Image Source="avares://Hatband.App/Assets/Icons/Platforms/macos.png"
                                               Width="17"
                                               Height="17"
                                               Stretch="Uniform"
                                               ToolTip.Tip="macOS"
                                               IsVisible="{Binding Session.SelectedGameCard.SupportsMacOS}" />
                                        <Image Source="avares://Hatband.App/Assets/Icons/Platforms/linux.png"
                                               Width="17"
                                               Height="17"
                                               Stretch="Uniform"
                                               ToolTip.Tip="Linux"
                                               IsVisible="{Binding Session.SelectedGameCard.SupportsLinux}" />
                                        <TextBlock Text="—"
                                                   Foreground="#AFC0CC"
                                                   FontSize="14"
                                                   IsVisible="{Binding Session.SelectedGameCard.HasNoNativePlatforms}" />
                                        <TextBlock Text="?"
                                                   Foreground="#AFC0CC"
                                                   FontSize="14"
                                                   ToolTip.Tip="{x:Static lang:Resources.UnknownPlatformSupport}"
                                                   IsVisible="{Binding Session.SelectedGameCard.HasUnknownNativePlatforms}" />
                                    </StackPanel>
                                </StackPanel>
                                <components:GameDetailStatView Grid.Row="2" Grid.Column="1"
                                                               Label="{x:Static lang:Resources.PlatformCompatibility}"
                                                               Value="{Binding Session.SelectedGameCard.PlatformCompatibilityLabel}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Padding="16,9"
                    CornerRadius="7"
                    Background="#C0090D12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{x:Static lang:Resources.HltbDetailsTitle}"
                               Foreground="#CFD7DE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Session.SelectedGameCard.HasTimeToBeat}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Session.SelectedGameCard.TimeToBeatSummary}"
                               Foreground="#E2E6EA"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Session.SelectedGameCard.HasTimeToBeat}" />
                    <Image Grid.Column="2"
                           Source="avares://Hatband.App/Assets/Stores/steam-wordmark-white.png"
                           Width="76"
                           Height="20"
                           Stretch="Uniform"
                           IsVisible="{Binding Session.SelectedGameCard.IsSteamSource}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Session.SelectedGameCard.SourceDisplayName}"
                               Foreground="#D2D9DF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Session.SelectedGameCard.IsNonSteamSource}" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</navigation:FullScreenView>

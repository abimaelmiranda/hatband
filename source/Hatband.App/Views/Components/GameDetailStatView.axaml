<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hatband.App.Views.Components.GameDetailStatView"
             x:Name="Root">
    <StackPanel Spacing="3">
            <TextBlock x:CompileBindings="False"
                       Text="{Binding Label, ElementName=Root}"
                       Foreground="#AFC0CC"
                       FontSize="{DynamicResource Typography.Micro}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:CompileBindings="False"
                       Text="{Binding Value, ElementName=Root}"
                       Foreground="#F2F5F7"
                       FontSize="{DynamicResource Typography.Caption}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>

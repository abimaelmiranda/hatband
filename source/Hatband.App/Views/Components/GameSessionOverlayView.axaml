<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:lang="using:Hatband.App.Localization"
             x:Class="Hatband.App.Views.Components.GameSessionOverlayView"
             x:DataType="vm:LibrarySessionViewModel">
    <Grid IsVisible="{Binding IsGameSessionActive}"
          Background="#FF11161C">
        <Image Source="{Binding ActiveGameSessionBackgroundImage}"
               Stretch="UniformToFill" />
        <Border Background="#A5090D12" />
        <Border Width="560"
                MaxWidth="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="42,36"
                CornerRadius="14"
                Background="#D91B252E"
                BorderBrush="#526B7884"
                BorderThickness="1">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <TextBlock Text="{x:Static lang:Resources.GameSessionOverlayTitle}"
                           HorizontalAlignment="Center"
                           Foreground="#A9BAC5"
                           FontSize="{DynamicResource Typography.BodyEmphasis}"
                           FontWeight="Bold"
                           LetterSpacing="1.2" />
                <TextBlock Text="{Binding ActiveGameSessionName}"
                           HorizontalAlignment="Center"
                           Foreground="#F4F6F8"
                           FontSize="{DynamicResource Typography.Display}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

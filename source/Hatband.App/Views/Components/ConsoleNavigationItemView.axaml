<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Hatband.App.Views.Components"
             x:Class="Hatband.App.Views.Components.ConsoleNavigationItemView"
             x:DataType="components:ConsoleNavigationItemView">
    <Button x:Name="NavigationButton"
            HorizontalAlignment="Stretch"
            Background="{Binding ItemBackground, RelativeSource={RelativeSource AncestorType=components:ConsoleNavigationItemView}}"
            BorderBrush="{Binding ItemBorderBrush, RelativeSource={RelativeSource AncestorType=components:ConsoleNavigationItemView}}"
            BorderThickness="1"
            Height="44"
            Padding="10,6"
            CornerRadius="6"
            HorizontalContentAlignment="Stretch"
            Click="OnButtonClick">
        <Grid ColumnDefinitions="30,*" ColumnSpacing="8">
            <TextBlock Text="{Binding Symbol, RelativeSource={RelativeSource AncestorType=components:ConsoleNavigationItemView}}"
                       Foreground="#AEBBC5"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=components:ConsoleNavigationItemView}}"
                       Foreground="#F1F5F8"
                       FontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=components:ConsoleNavigationItemView}}"
                       VerticalAlignment="Center" />
        </Grid>
    </Button>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:lang="using:Hatband.App.Localization"
             x:Class="Hatband.App.Views.Components.ArtworkPickerCarouselView"
             x:DataType="vm:GameArtworkPickerViewModel"
             IsVisible="{Binding IsArtworkPickerOpen}">
    <UserControl.Resources>
        <DataTemplate x:Key="CoverArtworkPreviewTemplate" x:DataType="vm:GameArtworkSourceOption">
            <StackPanel Width="150" Spacing="6" Margin="5">
                <Border Height="190" CornerRadius="6" Background="#11161C" ClipToBounds="True" Padding="4">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
                        <TextBlock Text="{x:Static lang:Resources.ArtworkPreviewUnavailable}" Foreground="#AFC0CC" FontSize="{DynamicResource Typography.Caption}" TextAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsPreviewUnavailable}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Typography.Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BackgroundArtworkPreviewTemplate" x:DataType="vm:GameArtworkSourceOption">
            <StackPanel Width="250" Spacing="6" Margin="5">
                <Border Height="150" CornerRadius="6" Background="#11161C" ClipToBounds="True" Padding="4">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
                        <TextBlock Text="{x:Static lang:Resources.ArtworkPreviewUnavailable}" Foreground="#AFC0CC" FontSize="{DynamicResource Typography.Caption}" TextAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsPreviewUnavailable}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Typography.Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LogoArtworkPreviewTemplate" x:DataType="vm:GameArtworkSourceOption">
            <StackPanel Width="210" Spacing="6" Margin="5">
                <Border Height="100" CornerRadius="6" Background="#11161C" ClipToBounds="True" Padding="4">
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
                        <TextBlock Text="{x:Static lang:Resources.ArtworkPreviewUnavailable}" Foreground="#AFC0CC" FontSize="{DynamicResource Typography.Caption}" TextAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsPreviewUnavailable}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Typography.Caption}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <TextBlock Text="{Binding ArtworkSourcesStatus}"
                   Foreground="#AFC0CC"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasArtworkSourcesStatus}" />

        <ListBox x:Name="CoverArtworkOptions"
                 ItemsSource="{Binding ActiveArtworkOptions}"
                 SelectedItem="{Binding SelectedActiveArtworkOption}"
                 ItemTemplate="{StaticResource CoverArtworkPreviewTemplate}"
                 GotFocus="OnArtworkOptionGotFocus"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 IsVisible="{Binding IsCoverPickerActive}"
                 MaxHeight="250">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ListBox x:Name="IconArtworkOptions"
                 ItemsSource="{Binding ActiveArtworkOptions}"
                 SelectedItem="{Binding SelectedActiveArtworkOption}"
                 ItemTemplate="{StaticResource CoverArtworkPreviewTemplate}"
                 GotFocus="OnArtworkOptionGotFocus"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 IsVisible="{Binding IsIconPickerActive}"
                 MaxHeight="180">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ListBox x:Name="LogoArtworkOptions"
                 ItemsSource="{Binding ActiveArtworkOptions}"
                 SelectedItem="{Binding SelectedActiveArtworkOption}"
                 ItemTemplate="{StaticResource LogoArtworkPreviewTemplate}"
                 GotFocus="OnArtworkOptionGotFocus"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 IsVisible="{Binding IsLogoPickerActive}"
                 MaxHeight="180">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <ListBox x:Name="BackgroundArtworkOptions"
                 ItemsSource="{Binding ActiveArtworkOptions}"
                 SelectedItem="{Binding SelectedActiveArtworkOption}"
                 ItemTemplate="{StaticResource BackgroundArtworkPreviewTemplate}"
                 GotFocus="OnArtworkOptionGotFocus"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 IsVisible="{Binding IsBackgroundPickerActive}"
                 MaxHeight="210">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hatband.App.ViewModels"
             xmlns:core="using:Hatband.Core.Models.Games"
             xmlns:lang="using:Hatband.App.Localization"
             x:Class="Hatband.App.Views.Components.CompatibilityEditorView"
             x:DataType="vm:CompatibilityEditorViewModel">
    <StackPanel Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static lang:Resources.Compatibility}" FontSize="22" FontWeight="SemiBold" />
            <Border Height="1" Background="#39454F" />
        </StackPanel>

        <TextBlock Text="{x:Static lang:Resources.CompatibilityLinuxOnly}" Foreground="#AFC0CC" />

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Static lang:Resources.CompatibilityMode}" Foreground="#D9E0E5" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static lang:Resources.NativeExecution}"
                        Classes="subtle-action"
                        Background="{Binding NativeButtonBackground}"
                        Click="OnNativeClick" />
                <Button Content="{x:Static lang:Resources.UseProton}"
                        Classes="subtle-action"
                        Background="{Binding ProtonButtonBackground}"
                        Click="OnProtonClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding UseProton}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{x:Static lang:Resources.ProtonVersion}" Foreground="#D9E0E5" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Static lang:Resources.Refresh}" Classes="subtle-action" Command="{Binding RefreshToolsCommand}" IsEnabled="{Binding !IsRefreshingTools}" />
            </Grid>
            <ComboBox ItemsSource="{Binding InstalledTools}"
                      SelectedItem="{Binding SelectedTool}"
                      IsEnabled="{Binding !IsRefreshingTools}"
                      PlaceholderText="{x:Static lang:Resources.SelectProtonVersion}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CompatibilityTool">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{x:Static lang:Resources.CompatibilityToolsRefreshing}"
                       Foreground="#AFC0CC"
                       IsVisible="{Binding IsRefreshingTools}" />
            <TextBlock Text="{x:Static lang:Resources.CompatibilityToolMissing}"
                       Foreground="#F5D59A"
                       IsVisible="{Binding HasMissingSelectedTool}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding UseProton}">
            <TextBlock Text="{x:Static lang:Resources.GamePrefix}" Foreground="#D9E0E5" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static lang:Resources.ManagedPrefix}"
                        Classes="subtle-action"
                        Background="{Binding ManagedPrefixButtonBackground}"
                        Click="OnManagedPrefixClick" />
                <Button Content="{x:Static lang:Resources.CustomPrefix}"
                        Classes="subtle-action"
                        Background="{Binding CustomPrefixButtonBackground}"
                        Click="OnCustomPrefixClick" />
            </StackPanel>
            <TextBlock Text="{Binding ManagedPrefixPath}" IsVisible="{Binding UseManagedPrefix}" TextWrapping="Wrap" Foreground="#AFC0CC" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !UseManagedPrefix}">
                <TextBox x:Name="PrefixPathTextBox"
                         Text="{Binding CustomPrefixPath}"
                         PlaceholderText="{x:Static lang:Resources.SelectGamePrefixFolder}" />
                <Button Grid.Column="1"
                        Content="{x:Static lang:Resources.ChooseFolder}"
                        Classes="subtle-action"
                        Click="OnChoosePrefixFolderClick" />
            </Grid>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#F5D59A" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
    </StackPanel>
</UserControl>
